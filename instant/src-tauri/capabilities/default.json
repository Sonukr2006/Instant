{
  "$schema": "../../../node_modules/@tauri-apps/cli/schema.json",
  "identifier": "default",
  "description": "Default capability set for Instant AI Context",
  "windows": ["overlay"],
  "webApi": {
    "all": false,
    "assetScope": {
      "allow": ["$APP/", "asset:///**"]
    }
  },
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
