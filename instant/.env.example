# App mode
# development: allows local/BYOK Gemini fallback for private testing.
# production: requires the Instant backend and a saved login session.
INSTANT_APP_MODE=development

# Remote backend mode
# Production builds must use this backend path. Do not ship public builds that rely on local AI keys.
INSTANT_API_BASE_URL=http://127.0.0.1:8080
# Development-only token injection. Production login should save the token through the app auth session.
INSTANT_API_TOKEN=your_login_jwt_token_here

# Development/private BYOK Gemini fallback
# These values are ignored for production launch behavior because production mode requires backend AI calls.
# App config file example:
# instant-ai-context.json -> {"app_mode":"development", "backend_api_url":"https://api.example.com", "backend_auth_token":"...", "gemini_api_key":"...", "gemini_model":"gemini-2.5-flash", "gemini_api_version":"v1beta"}
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_VERSION=v1beta

# App environment
VITE_ENV=development
